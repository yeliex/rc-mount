{
  "name": "rc-mount",
  "version": "2.1.0",
  "description": "react extra component mount decorator",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "src/index.ts",
  "scripts": {
    "test": "tsc --noEmit",
    "build": "pkgroll --clean-dist",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf ./dist"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeliex/rc-mount.git"
  },
  "keywords": [
    "react",
    "react-component",
    "react-com",
    "antd"
  ],
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "author": "yeliex <yeliex@yeliex.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yeliex/rc-mount/issues"
  },
  "homepage": "https://github.com/yeliex/rc-mount#readme",
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "pkgroll": "^2.5.0",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@types/react": ">=17.0.0",
    "@types/react-dom": ">=17.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c"
}
